{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "api/**/*.ts",
    "src/lib/types.ts",
    "src/lib/pricing.ts",
    "src/lib/qrOrderCore.ts",
    "src/lib/seed.ts",
    "src/lib/storage.ts"
  ]
}
