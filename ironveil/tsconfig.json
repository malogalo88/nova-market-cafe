{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "*": ["./node_modules/*"]
    }
  },
  "include": [
    "shared/src/**/*.ts",
    "server/src/**/*.ts",
    "client/src/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts"
  ]
}
