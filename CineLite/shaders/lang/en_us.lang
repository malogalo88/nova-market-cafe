screen.CINE_LITE=CineLite Settings

option.FAKE_RAY_TRACING=Fake Ray Tracing
option.FAKE_RAY_TRACING.comment=Faked ray-traced lighting: analytic bounce fill, coloured neighbour bounce light and indirect glow. Contains zero real ray tracing.
