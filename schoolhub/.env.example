# SchoolHub environment variables
# Copy to .env and adjust.

# SQLite database file (relative to the prisma folder)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL (used in links, optional)
NEXT_PUBLIC_APP_NAME="SchoolHub"
